# Used only by `npm run migrate` - needs privileges to CREATE TABLE/ROLE/POLICY.
# Never point the running server at this connection string.
MIGRATION_DATABASE_URL=postgres://postgres:postgres@localhost:5432/medgram

# Used by the running server. Must connect as the medgram_app role created in
# backend/db/schema/900_rls.sql, NOT as the migration owner - RLS is only
# enforced for non-owner roles (see the FORCE ROW LEVEL SECURITY comment
# there). medgram_app has no login password until you set one:
#   ALTER ROLE medgram_app LOGIN PASSWORD '...';
APP_DATABASE_URL=postgres://medgram_app:changeme@localhost:5432/medgram

JWT_SECRET=replace-with-a-long-random-value
# Matches utils/config.js's EXPO_PUBLIC_DEV_PORT default in the frontend -
# change both together, not just one.
PORT=3001

# Optional: /auth/google returns 503 GOOGLE_AUTH_NOT_CONFIGURED without this.
# Must be the SAME client id the frontend uses (EXPO_PUBLIC_GOOGLE_CLIENT_ID
# in its .env) - the audience check in lib/googleIdToken.ts requires it.
GOOGLE_CLIENT_ID=
