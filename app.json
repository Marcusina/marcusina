{
  "expo": {
    "name": "Medgram",
    "slug": "medgram",
    "scheme": "medgram",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anonymous.medgram",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-video",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Medgram uses your location to fill in your profile's geospatial coordinates for location-based search."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0488b106-8ce7-4eca-9c4c-4be559136be2"
      }
    },
    "owner": "marcusina"
  }
}
