# Explicit override - takes priority over the local/LAN host construction in
# both dev and prod (see EXPLICIT_API_BASE_URL in utils/config.js). Leave
# unset to fall back to the local dev server instead.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

NODE_ENV=development

# Local development overrides
EXPO_PUBLIC_DEV_PORT=3001
EXPO_PUBLIC_DEV_IP_IOS=192.168.1.52
EXPO_PUBLIC_DEV_IP_ANDROID_PHYSICAL=192.168.1.52

# Optional: enables the "Sign in with Google" button. Leave unset to disable it.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=